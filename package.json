{
  "name": "mycowoker",
  "version": "1.0.0",
  "description": "Activity Tracker - A modern local-first developer activity and time tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,green.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "start": "npm run start --workspace=server",
    "build": "npm run build --workspace=client",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "activity-tracker",
    "time-tracking",
    "developer-dashboard",
    "react",
    "express",
    "vite"
  ],
  "author": "",
  "license": "MIT"
}
